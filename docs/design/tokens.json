{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "product": "KLOCKR",
    "status": "V1 visual baseline",
    "note": "Semantic source values for implementation. Green/amber/red are operational states, not decorative brand colors."
  },
  "color": {
    "background": {
      "canvas": { "$value": "#0B0B0D", "$type": "color" },
      "chrome": { "$value": "#101114", "$type": "color" },
      "surface": { "$value": "#141418", "$type": "color" },
      "surfaceRaised": { "$value": "#1A1D22", "$type": "color" },
      "control": { "$value": "#1F2126", "$type": "color" },
      "controlHover": { "$value": "#262A31", "$type": "color" }
    },
    "border": {
      "subtle": { "$value": "#2B2F36", "$type": "color" },
      "strong": { "$value": "#3A4049", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "#F5F7FA", "$type": "color" },
      "secondary": { "$value": "#9AA0A6", "$type": "color" },
      "muted": { "$value": "#6F7680", "$type": "color" }
    },
    "accent": {
      "blue": { "$value": "#3B82F6", "$type": "color" },
      "blueStrong": { "$value": "#1D9BF0", "$type": "color" },
      "blueDim": { "$value": "#0C3151", "$type": "color" }
    },
    "state": {
      "ok": { "$value": "#22C55E", "$type": "color" },
      "warning": { "$value": "#F59E0B", "$type": "color" },
      "critical": { "$value": "#EF4444", "$type": "color" },
      "offline": { "$value": "#9AA0A6", "$type": "color" }
    }
  },
  "spacing": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" }
  },
  "radius": {
    "control": { "$value": "6px", "$type": "dimension" },
    "panel": { "$value": "8px", "$type": "dimension" },
    "large": { "$value": "12px", "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension" }
  },
  "typography": {
    "uiFamily": { "$value": "Inter, system-ui, sans-serif", "$type": "fontFamily" },
    "technicalFamily": { "$value": "Roboto Mono, ui-monospace, monospace", "$type": "fontFamily" }
  }
}
