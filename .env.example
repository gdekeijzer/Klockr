# Local development only. Never commit real secrets.
DATABASE_URL=postgres://klockr:klockr@localhost:54329/klockr_dev
SERVER_HOST=127.0.0.1
SERVER_PORT=4000
LOG_LEVEL=info
WORKER_INTERVAL_MS=60000
# Set true behind HTTPS so credential cookies get the Secure attribute.
COOKIE_SECURE=false
# Apply migrations when the server starts (local convenience; ACC/PRD migrate explicitly).
MIGRATE_ON_START=false
# Where the web app (Next rewrites) sends /api/v1 and /realtime traffic locally.
KLOCKR_SERVER_URL=http://127.0.0.1:4000
# Public origin for absolute links built without a request (e.g. future e-mails).
# PRD: https://klockr.live  ·  ACC: its own URL  ·  never hardcoded in code.
KLOCKR_PUBLIC_URL=http://localhost:3000
